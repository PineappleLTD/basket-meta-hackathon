# Non-secret Compose configuration, saved as /opt/basket/config/compose.env.
# Use a domain you control, or basket.<VM-public-IPv4>.sslip.io for the demo.
BASKET_HOSTNAME=replace-with-public-hostname
BASKET_IMAGE=basket:replace-with-commit
BASKET_ENV_FILE=/opt/basket/config/runtime.env

# Leave disabled until the Render schedulers have stopped.
NEWS_MONITOR_ENABLED=false
LIVE_REFRESH_SECONDS=0
